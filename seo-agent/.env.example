# Autopilot SEO Environment Configuration

# Backend / Django
DJANGO_SECRET_KEY=django-insecure-autopilot-seo-dev-key-change-in-production!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,server
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://autopilot:autopilot@postgres:5432/autopilot_seo
POSTGRES_DB=autopilot_seo
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=autopilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
